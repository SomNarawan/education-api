# Local deploy test of this stack. Copy to .env.localdeploy and fill the secrets:
#   docker compose --env-file .env.localdeploy up -d --build
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3009

# Host port for phpMyAdmin (compose default: 8080)
PHPMYADMIN_PORT=8081

# php artisan key:generate --show
APP_KEY=
# Used only when the dbdata volume is first created.
DB_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_REQUIRE_EXPIRATION=true

CMIS_URL=
OFFICE_KU_API_URL=https://office.eng.kps.ku.ac.th
OFFICE_KU_API_TIMEOUT=30
OFFICE_KU_API_VERIFY_SSL=false
PORTAL_MAIN_API_KEY=

# Mock for staff too, unlike production: ENG Main cannot redirect back to localhost.
MOCK_LOGIN_ENABLED=true
MOCK_LOGIN_STUDENT_ENABLED=true
MOCK_LOGIN_FRONTEND_URL=http://localhost:3008
MOCK_LOGIN_STUDENT_FRONTEND_URL=http://localhost:3002
# 3008: this stack's frontend. 3001, 3002: education-web's docker:up and dev scripts.
FRONTEND_URL=http://localhost:3008,http://localhost:3001,http://localhost:3002

# Build args of the frontend service.
VITE_API_URL=http://localhost:3009/api
VITE_BASE_PATH=
VITE_AUTH_PROVIDER=mock
VITE_PORTAL_LOGIN_URL=https://office.eng.kps.ku.ac.th/eng-main/home
VITE_PORTAL_LOGOUT_URL=
