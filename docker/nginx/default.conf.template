# Rendered at container start by the nginx image's envsubst step
# (NGINX_ENVSUBST_FILTER=^HEALTH_ in the Dockerfile): only ${HEALTH_TOKEN} is
# substituted, nginx's own $variables are left alone.

# Skip access-log lines for healthcheck probes.
map $request_uri $loggable {
    ~^/up(\?|$)          0;
    ~^/api/health(\?|$)  0;
    default              1;
}

server {
    # IPv4 only: Docker publishes the port over IPv4, and an IPv6 listen
    # fails to start on hosts with IPv6 disabled.
    listen 3009 default_server;
    server_name _;

    root /var/www/html/public;
    index index.php;

    server_tokens off;
    access_log /var/log/nginx/access.log main if=$loggable;

    # Imports accept xlsx up to 20 MB (max:20480). nginx defaults to 1 MB.
    client_max_body_size 25m;

    # Docker's embedded DNS, re-resolved every 10s, so nginx follows
    # laravel-app when it is recreated on deploy or scaled to several replicas.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $php_upstream laravel-app:9000;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # nginx's own liveness (container healthcheck). Does not touch PHP, so nginx
    # stays healthy while laravel-app is still starting; app health is /up.
    location = /_nginx {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Only the front controller is executable.
    location = /index.php {
        fastcgi_pass $php_upstream;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_hide_header X-Powered-By;

        # Matches PHP max_execution_time (300s); long synchronous imports.
        fastcgi_read_timeout 300s;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;

        # php-fpm unreachable (laravel-app stopped, restarting, or never started
        # because the migration failed): answer in JSON instead of an HTML 502.
        error_page 502 504 = @backend_down;
    }

    location @backend_down {
        default_type application/json;
        return 503 '{"status":"down","checks":{"backend":{"ok":false}},"message":"nginx is running but laravel-app (php-fpm) is not reachable. Container states: /_status?token=<HEALTH_TOKEN>"}\n';
    }

    # What each container (migrate, app, queue) is doing, written by
    # status.php to the shared storage volume. Served by nginx itself so it
    # still answers when PHP is down. Requires ?token=<HEALTH_TOKEN>; returns
    # 404 while HEALTH_TOKEN is empty.
    location = /_status {
        access_log off;
        if ($arg_token = "") {
            return 404;
        }
        if ($arg_token != "${HEALTH_TOKEN}") {
            return 404;
        }
        default_type application/json;
        expires -1;
        alias /var/www/html/storage/app/status/status.json;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
