# ---- vendor build stage ----
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist
COPY . .
# Drop what the running API never reads, before the classmap is built:
#   - frontend tooling (this image serves no built assets) and files that are
#     copied into the runtime stage separately (docker/, vhost.conf)
#   - package docs/CI files in vendor
#   - Carbon translations other than th/en (APP_LOCALE=th, fallback en)
RUN set -eux; \
    rm -rf package.json package-lock.json vite.config.js resources/js resources/css \
           docker vhost.conf; \
    find vendor -type d -name .github -prune -exec rm -rf {} +; \
    find vendor -type f \( -iname '*.md' -o -name '.gitattributes' -o -name '.editorconfig' \) -delete; \
    find vendor/nesbot/carbon/src/Carbon/Lang -type f ! -name 'th*.php' ! -name 'en.php' ! -name 'en_*.php' -delete
RUN composer dump-autoload --optimize --no-dev

# ---- runtime stage (nginx + php-fpm bundled, port 3009) ----
# Official php-fpm-alpine + nginx instead of webdevops/php-nginx: that image
# ships ImageMagick, Ghostscript, supervisor, vim and ~60 PHP extensions this
# API never uses (~650MB). Extensions added on top of the base image:
#   pdo_mysql - the database
#   zip       - ZipArchive, used by app/Services/Excel/XlsxDataValidationWriter
#               (student/grade import templates); declared as ext-zip in composer.json
FROM php:8.2-fpm-alpine

RUN set -eux; \
    apk add --no-cache nginx libzip; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS libzip-dev; \
    docker-php-ext-install -j"$(nproc)" pdo_mysql zip; \
    apk del --no-network .build-deps; \
    rm -rf /tmp/* /etc/nginx/http.d/default.conf; \
    ln -sf /dev/stdout /var/log/nginx/access.log; \
    ln -sf /dev/stderr /var/log/nginx/error.log; \
    mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY docker/api/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/api/php-fpm.conf /usr/local/etc/php-fpm.d/zz-app.conf
COPY vhost.conf /etc/nginx/http.d/app.conf
COPY --chmod=0755 docker/api/start.sh /usr/local/bin/start

WORKDIR /app
COPY --from=vendor /app ./
RUN chown -R www-data:www-data storage bootstrap/cache

EXPOSE 3009

# /api/health answers 503 only when a critical check fails (database,
# migrations, queue, storage); external services are cached and only make it
# "degraded" (still 200), so a CMIS outage never marks this container unhealthy.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO /dev/null http://127.0.0.1:3009/api/health || exit 1

CMD ["start"]
