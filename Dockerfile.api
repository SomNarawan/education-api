# ---- vendor build stage ----
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist
COPY . .
RUN composer dump-autoload --optimize --no-dev

# ---- runtime stage (nginx + php-fpm bundled, port 3009) ----
# Official php-fpm-alpine + nginx instead of webdevops/php-nginx: that image
# ships ImageMagick, Ghostscript, supervisor, vim and ~60 PHP extensions this
# API never uses (~650MB). The base image already has every extension
# composer.lock requires; only pdo_mysql is added.
FROM php:8.2-fpm-alpine

RUN set -eux; \
    apk add --no-cache nginx; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS; \
    docker-php-ext-install -j"$(nproc)" pdo_mysql; \
    apk del --no-network .build-deps; \
    rm -rf /tmp/* /etc/nginx/http.d/default.conf; \
    ln -sf /dev/stdout /var/log/nginx/access.log; \
    ln -sf /dev/stderr /var/log/nginx/error.log; \
    mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY docker/api/php.ini /usr/local/etc/php/conf.d/zz-app.ini
COPY docker/api/php-fpm.conf /usr/local/etc/php-fpm.d/zz-app.conf
COPY vhost.conf /etc/nginx/http.d/app.conf
COPY --chmod=0755 docker/api/start.sh /usr/local/bin/start

WORKDIR /app
COPY --from=vendor /app ./
RUN chown -R www-data:www-data storage bootstrap/cache

EXPOSE 3009
CMD ["start"]
