APP_NAME="Education API"
# staging while mock login is the only login: MockLoginController returns 404
# when APP_ENV=production. Switch to production once real SSO is wired up.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api
CMIS_URL=

PERSONNEL_API_URL=https://office.eng.kps.ku.ac.th

# External CMIS service used through this API as an intermediary.
CMIS_SERVICE_BASE_PATH=/api
CMIS_SERVICE_TIMEOUT=15
CMIS_SERVICE_VERIFY_SSL=true

APP_LOCALE=th
APP_FALLBACK_LOCALE=th

APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=stack
LOG_LEVEL=error

# docker-compose.yml points the api/queue at its own mysql container
# (database education_dss, user root) - only the password is read from here.
DB_PASSWORD=

# docker-compose.yml also fixes SESSION_DRIVER=file, CACHE_STORE=file and
# QUEUE_CONNECTION=database (the queue container runs the jobs).
SESSION_LIFETIME=120
# Must be longer than the slowest job, or the job may be picked up again.
DB_QUEUE_RETRY_AFTER=1800

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@education.local"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_REQUIRE_EXPIRATION=false

# Temporary API key for Portal Main server-to-server access.
# Replace with the central auth system once it is available.
# Generate with: openssl rand -hex 32
PORTAL_MAIN_API_KEY=

# TODO: set to false once real SSO is wired up — mock-login bypasses it.
MOCK_LOGIN_ENABLED=true
FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
MOCK_LOGIN_FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
# The student site (docker-compose.public.yml in education-web, on eng.kps.ku.ac.th).
MOCK_LOGIN_STUDENT_FRONTEND_URL=https://eng.kps.ku.ac.th/kukps-eng-education-ssd-public
VITE_API_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api/api
VITE_BASE_PATH=/kukps-eng-education-ssd
MOCK_LOGIN_ADMIN_NONTRI_IDS=

# GET /api/health: ?token=<HEALTH_TOKEN> adds error details. Empty = details off.
# Generate with: openssl rand -hex 32
HEALTH_TOKEN=

# Host ports the server's reverse proxy points at.
WEB_PORT=3008
API_PORT=3009
QUEUE_PORT=3012
PHPMYADMIN_PORT=8080
