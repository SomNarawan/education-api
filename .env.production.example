APP_NAME="Education API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api
CMIS_URL=

PERSONNEL_API_URL=https://office.eng.kps.ku.ac.th

# External CMIS service used through this API as an intermediary.
CMIS_SERVICE_BASE_PATH=/api
CMIS_SERVICE_TIMEOUT=15
CMIS_SERVICE_VERIFY_SSL=true

APP_LOCALE=th
APP_FALLBACK_LOCALE=th

APP_TIMEZONE=Asia/Bangkok

# docker-compose forces LOG_CHANNEL=stderr so logs appear in `docker logs`.
LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
# docker-compose always connects to its mysql service (DB_HOST=mysql, port 3306).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=education_dss
# Prefer a dedicated user over root (see README > Docker Compose).
DB_USERNAME=
DB_PASSWORD=
# MySQL root password. Only applied when the mysql volume is first created;
# falls back to DB_PASSWORD when empty.
DB_ROOT_PASSWORD=

# database: shared by every container (app replicas + queue worker).
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

# Grade imports run in the laravel-queue container.
QUEUE_CONNECTION=database
# Must be longer than the slowest job, or a second worker may run it again.
DB_QUEUE_RETRY_AFTER=1800
# How long `docker compose stop` waits for the running job before SIGKILL.
QUEUE_STOP_GRACE_PERIOD=180s

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@education.local"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_REQUIRE_EXPIRATION=false

# Temporary API key for Portal Main server-to-server access.
# Replace with the central auth system once it is available.
# Generate with: openssl rand -hex 32
PORTAL_MAIN_API_KEY=

# TODO: set to false once real SSO is wired up — mock-login bypasses it.
MOCK_LOGIN_ENABLED=true
FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
MOCK_LOGIN_FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
VITE_API_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api/api
VITE_BASE_PATH=/kukps-eng-education-ssd
MOCK_LOGIN_ADMIN_NONTRI_IDS=
