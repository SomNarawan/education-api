APP_NAME="Education API"
# production turns mock login off whatever MOCK_LOGIN_ENABLED says; staff
# sign in through the portal. Use staging only on a test server.
APP_ENV=production
# Also encrypts the portal tokens in auth_sessions: changing it ends every session.
APP_KEY=
APP_DEBUG=false
APP_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api
CMIS_URL=

PERSONNEL_API_URL=https://office.eng.kps.ku.ac.th

# External CMIS service used through this API as an intermediary.
CMIS_SERVICE_BASE_PATH=/api
CMIS_SERVICE_TIMEOUT=15
CMIS_SERVICE_VERIFY_SSL=true

APP_LOCALE=th
APP_FALLBACK_LOCALE=th

APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@education.local"
MAIL_FROM_NAME="${APP_NAME}"

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_REQUIRE_EXPIRATION=true

# Portal login: KU All Login through ENG Main (POST /api/auth/portal-login).
PORTAL_MAIN_API_URL=https://office.eng.kps.ku.ac.th/eng-main/api
PORTAL_SYSTEM_ID=33
# ENG Main role:role of this app, comma separated (ENG Main side is case-insensitive).
PORTAL_ROLE_MAP=admin:admin,staff:teacher
ORG_AUTH_API_URL=https://eng.kps.ku.ac.th/std-eng-auth-service
PORTAL_VERIFY_SSL=true
# CA bundle for the calls above, e.g. storage/certs/office-ca.pem (preferred over PORTAL_VERIFY_SSL=false).
PORTAL_CA_FILE=
PORTAL_TIMEOUT=10
PORTAL_RECHECK_SECONDS=120

# Temporary API key for Portal Main server-to-server access.
# Replace with the central auth system once it is available.
# Generate with: openssl rand -hex 32
PORTAL_MAIN_API_KEY=

# Must stay false: mock-login bypasses the portal (and is ignored under APP_ENV=production).
MOCK_LOGIN_ENABLED=false
FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
MOCK_LOGIN_FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
VITE_API_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api/api
VITE_BASE_PATH=/kukps-eng-education-ssd
VITE_AUTH_PROVIDER=portal
VITE_PORTAL_LOGIN_URL=https://office.eng.kps.ku.ac.th/eng-main/home
# Empty = back to VITE_PORTAL_LOGIN_URL after logout.
VITE_PORTAL_LOGOUT_URL=
MOCK_LOGIN_ADMIN_NONTRI_IDS=
