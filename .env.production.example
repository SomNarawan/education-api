APP_NAME="Education API"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api

PERSONNEL_API_URL=https://office.eng.kps.ku.ac.th

APP_LOCALE=th
APP_FALLBACK_LOCALE=th

APP_TIMEZONE=Asia/Bangkok

# stderr = Laravel log shows up in `docker logs`. (stack also goes to stderr
# in the image, through LOG_STACK=stderr.)
LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=kukps-education-dss
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=database
# Must be longer than the slowest job, or a second worker may run it again.
DB_QUEUE_RETRY_AFTER=1800

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@education.local"
MAIL_FROM_NAME="${APP_NAME}"

# TODO: ต้องเป็น secret เดียวกับที่ทีม SSO ใช้เซ็น JWT จริง ไม่ใช่ค่าทดสอบนี้
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_REQUIRE_EXPIRATION=false

MOCK_LOGIN_ENABLED=true
FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
# Where mock-login redirects back to (compose defaults to http://localhost:3008).
MOCK_LOGIN_FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
MOCK_LOGIN_ADMIN_NONTRI_IDS=fengame,fengvry

# Host ports are left to the server admin. Defaults in docker-compose.yml:
# API_PORT=3009, WEB_PORT=3008, PHPMYADMIN_PORT=3010; override here if needed.

VITE_API_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api/api
VITE_BASE_PATH=/kukps-eng-education-ssd

# Temporary API key for Portal Main server-to-server access.
# Replace with the central auth system once it is available.
# openssl rand -hex 32
PORTAL_MAIN_API_KEY=

# Opens /api/health details and /_status. openssl rand -hex 32
HEALTH_TOKEN=

# phpMyAdmin container (MySQL login required). Set when Apache serves it under a sub-path, e.g.
# https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-pma/
PHPMYADMIN_URL=
