APP_NAME="Education API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api

PERSONNEL_API_URL=https://office.eng.kps.ku.ac.th

# Switch to http and set the URL when the curriculum service is available.
CURRICULUM_API_DRIVER=mock
CURRICULUM_API_URL=
CURRICULUM_API_BASE_PATH=
CURRICULUM_API_STUDY_PLANS_ENDPOINT=/study-plans
CURRICULUM_API_CATEGORIES_ENDPOINT=/curriculum-categories
CURRICULUM_API_TIMEOUT=15
CURRICULUM_API_VERIFY_SSL=true

APP_LOCALE=th
APP_FALLBACK_LOCALE=th

APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@education.local"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_REQUIRE_EXPIRATION=false

# TODO: set to false once real SSO is wired up — mock-login bypasses it.
MOCK_LOGIN_ENABLED=true
FRONTEND_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd
VITE_API_URL=https://office.eng.kps.ku.ac.th/kukps-eng-education-ssd-api/api
VITE_BASE_PATH=/kukps-eng-education-ssd
MOCK_LOGIN_ADMIN_NONTRI_IDS=
